# Scrumbler Environment Variables
PROJECT_NAME=Scrumbler
DEBUG=True

# Database connection string:
# Local SQLite async:
DATABASE_URL=sqlite+aiosqlite:///./scrumbler.db

# Docker / Postgres async example (uncomment for postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scrumbler

SECRET_KEY=change-this-secret-key-in-production-random-hash-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
